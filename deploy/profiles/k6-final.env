PROJECTOR_WRITE_MODE=active
PROJECTOR_GROUP_ID=projector-k5-production
DE_WEBHOOK_ENABLED=false
RAW_CONSUMER_ENABLED=true
BRONZE_ENABLED=true
K4_CUTOVER_MAX_LAG=0
