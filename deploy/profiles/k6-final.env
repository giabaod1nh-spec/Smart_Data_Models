# K-6b canonical Kafka-only containerized runtime.
ARCHITECTURE_PROFILE=k6-final
ARCHITECTURE_LOCK_SMOKE=false
ORION_PUBLISH_ENABLED=false
ORION_SYNC_PUBLISH=false
KAFKA_OUTBOX_ENABLED=true
