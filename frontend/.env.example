# Smart Traffic Dashboard — Environment Variables
# Copy to .env.local and fill in values for your environment

# Leave empty for the Vite same-origin /api proxy (recommended for local dev).
# Set an absolute Spring Server URL only for a deployed frontend.
VITE_API_BASE_URL=

# Realtime polling interval in ms (default: 2000)
VITE_REALTIME_REFETCH_MS=2000

# Control command status poll interval in ms (default: 1000)
VITE_CONTROL_STATUS_POLL_MS=1000

# Analytics refresh interval in ms (default: 60000 for 60s windows)
VITE_ANALYTICS_REFRESH_MS=60000

# Analytics refresh interval in ms for 300s windows (default: 300000)
VITE_ANALYTICS_REFRESH_300_MS=300000
