# Non-secret Gold M1 / Gold4 Compose bindings (Gold Runtime Contract v1).
# Credentials stay empty for local default; inject secrets via the environment only.

GOLD_CLICKHOUSE_HOST=clickhouse
GOLD_CLICKHOUSE_PORT=8123
GOLD_CLICKHOUSE_DATABASE=smart_traffic
GOLD_CLICKHOUSE_USER=default
GOLD_CLICKHOUSE_PASSWORD=

GOLD_NAMESPACE=live
GOLD_DESTINATION_MODE=main
GOLD_CHECKPOINT_PATH=/app/de/artifacts/gold/checkpoint.sqlite3
GOLD_INSTANCE_LOCK_PATH=/app/de/artifacts/gold/instance.lock

GOLD_DEFINITION_VERSION=v1.0
GOLD_GOLD_SCHEMA_VERSION=k10-gold-m1-v1
GOLD_ALLOWED_LATENESS_SEC=0
GOLD_WATERMARK_DELAY_SEC=0

# Source cadences (required; no implicit default in Gold3 settings).
# Compose binding matches Gold3 smoke evidence (10s). Producer cadence evidence remains G3-P0-010.
GOLD_TRAFFIC_EXPECTED_CADENCE_SEC=10
GOLD_INTERSECTION_EXPECTED_CADENCE_SEC=10
GOLD_SIGNAL_EXPECTED_CADENCE_SEC=10

GOLD_HEALTH_HOST=0.0.0.0
GOLD_HEALTH_PORT=8096
GOLD_HEALTH_SNAPSHOT_MAX_AGE_SEC=60
GOLD_POLL_INTERVAL_SEC=2.0
GOLD_MAX_WINDOWS_PER_CYCLE=1
GOLD_SILVER_FETCH_BATCH_SIZE=500
GOLD_READINESS_LAG_THRESHOLD_SEC=120
GOLD_SHUTDOWN_TIMEOUT_SEC=30
