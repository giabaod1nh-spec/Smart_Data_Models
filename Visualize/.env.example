# Copy to .env or set in PowerShell before running.

SUMO_HOME=D:\SUMO
ORION_URL=http://localhost:1026
SUMO_GUI=true
# PUBLISH_NODES=A,B,C,D
PUBLISH_NODES=A
PUBLISH_INTERVAL=1.0
OBSERVATION_INTERVAL_SEC=1.0
CONTROL_API_PORT=9090
SUMO_SEED=42
LOG_LEVEL=INFO
PCU_FALLBACK=1.0

# Async Orion publisher (default on — TraCI never blocks on HTTP)
ORION_ASYNC_PUBLISH=true
ORION_PUBLISH_QUEUE_SIZE=5
ORION_PUBLISH_BACKPRESSURE_WARN_DEPTH=3
ORION_PUBLISH_MAX_LAG_SEC=5
ORION_PUBLISH_RESUME_LAG_SEC=2
ORION_PUBLISH_RESUME_MAX_DEPTH=1
ORION_PUBLISH_WORKER_COUNT=1
ORION_PUBLISH_SHUTDOWN_TIMEOUT_SEC=15
ORION_PUBLISH_RETRY_MAX=10
ORION_PUBLISH_RETRY_BASE_SEC=0.5
ORION_PUBLISH_RETRY_SLOW_SEC=5
ORION_PUBLISH_HTTP_TIMEOUT_SEC=5
# sequential (default/safe) | batch (opt-in after GUI gate)
ORION_PUBLISH_MODE=sequential
# Must stay "update" — do not use replace/upsert for this feature
ORION_BATCH_OPTIONS=update
ORION_PUBLISH_BATCH_TIMEOUT_SEC=10
# Runtime Orion publish gate (initial only; mid-run: POST /control/orion-publish)
ORION_PUBLISH_ENABLED=true
# ORION_PERF_AUDIT=0

# Architecture profile (none|migration|k5-cutover|final)
# ARCHITECTURE_PROFILE=none
# ARCHITECTURE_LOCK_SMOKE=false

# K-5 cutover (production projector — use deploy/profiles/k5-cutover.env)
# ARCHITECTURE_PROFILE=k5-cutover
# ORION_PUBLISH_ENABLED=false
# KAFKA_OUTBOX_ENABLED=true
# PROJECTOR_SHADOW_MODE=false
# PROJECTOR_TARGET_NAMESPACE=production
# PROJECTOR_WRITE_MODE=disabled
# PROJECTOR_GROUP_ID=projector-k5-production
# PROJECTOR_FENCE_MANIFEST=docs/architecture/k5_evidence/<run_id>/fence_manifest.json

# Projector (K-3) — default shadow for migration/K-4.5; production namespace = K-5 only
PROJECTOR_SHADOW_MODE=true
PROJECTOR_TARGET_NAMESPACE=shadow
PROJECTOR_HEALTH_HOST=0.0.0.0
PROJECTOR_HEALTH_PORT=8092

# Sync publish is debug-only (forbidden when ARCHITECTURE_PROFILE=migration|final)
ORION_SYNC_PUBLISH=false

# Kafka dual-publish (K-2a) — default off; requires K-1 broker on :29092
KAFKA_PUBLISH_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=traffic.entity-events.v2
KAFKA_CLIENT_ID=visualize-kafka-producer
KAFKA_PRODUCER_ID=visualize-traci
KAFKA_LINGER_MS=10
KAFKA_DELIVERY_TIMEOUT_MS=30000
KAFKA_REQUEST_TIMEOUT_MS=10000
# KAFKA_EVIDENCE_ROOT=artifacts/kafka_producer_ledger

# Kafka durable outbox (K-2b) — when true, TraCI COMMITs cycle to SQLite; worker delivers
KAFKA_OUTBOX_ENABLED=false
# KAFKA_OUTBOX_DB=artifacts/kafka_outbox/outbox.sqlite3
KAFKA_OUTBOX_MAX_IN_FLIGHT=32
KAFKA_OUTBOX_ACKED_RETENTION_DAYS=7
