{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-traffic.local/contracts/delivery/notification.schema.json",
  "title": "NGSI-LD Subscription Notification (RT-DE v1)",
  "type": "object",
  "required": ["id", "type", "data"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "Notification" },
    "subscriptionId": { "type": "string" },
    "notifiedAt": { "type": "string" },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["Intersection", "TrafficLight", "VehicleSensor", "Camera"]
          },
          "simulationTime": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": { "const": "Property" },
              "value": { "type": "number" }
            }
          },
          "simulationRunId": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": { "const": "Property" },
              "value": { "type": "string" }
            }
          },
          "scenarioId": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": { "const": "Property" },
              "value": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
